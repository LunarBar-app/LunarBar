        { "path": "<PRODUCTS>/LunarBar.app", "id": "874E99292B33D8C0002FC90A", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/LunarBarMacTests.xctest", "id": "8732DDF02B3E896D004B72DE", "type": "wrapper.cfbundle", "index": false },
