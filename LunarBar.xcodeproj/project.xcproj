  "targets": [
    {
      "name": "LunarBarMac",
      "id": "874E99282B33D8C0002FC90A",
      "product": "Products/LunarBar.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "Build.xcconfig" },
        { "name": "Release", "file": "Build.xcconfig" },
      ],
      "dependencies": [
        { "kind": "package", "product-name": "SwiftLint", "product-type": "build-tool-plugin" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "AppKitControls",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "AppKitExtensions",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "LunarBarKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_OPTIMIZATION[config=Release]": "space",
        "CODE_SIGN_ENTITLEMENTS": "LunarBarMac/Info.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "$(inherited)",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "$(inherited)",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "LunarBarMac/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "LunarBar",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "A bright moon rises over the sea, sharing this moment, though worlds apart.",
        "INFOPLIST_KEY_NSPrincipalClass": "NSApplication",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "$(inherited)",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(inherited)",
        "PRODUCT_NAME": "LunarBar",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "LunarBarMacTests",
      "id": "8732DDEF2B3E896D004B72DE",
      "product": "Products/LunarBarMacTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "LunarBarMac",
      "dependencies": [
        "LunarBarMac",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "$(inherited)",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "$(inherited)",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "$(inherited)",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.cyan.lunarbar-tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "5.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/LunarBar.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/LunarBar",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
